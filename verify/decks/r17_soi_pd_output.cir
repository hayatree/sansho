.model dev nmos(level=10 version=4.4 tox=4.6n tsi=75n tbox=105n nch=1.1e17 k1=.42 vth0=.48 u0=.047 alpha0=.00012 beta2=.24 vdsatii0=1.08 isdif=.015 isbjt=.001)
