BSIM1 XPART drain/source displacement current
* Provenance: original Sansho R14 circuit.
* sweep: xpart 0 1
.param probe=0
Vd d 0 1.5
Vg g 0 1.4 ac 1
Vb b 0 -.25
Vs s 0 0
M1 d g s b dev w=4u l=1.2u
.model dev nmos(level=4 phi=.7 vfb=-.52 k1=.55 k2=.025 tox=.025 muz=470 u0=.12 u1=.1 eta=.012 vdd=3 temp=27 n0=1.45 xpart={probe})
.ac dec 4 10k 100meg
.save i(Vg) i(Vd) i(Vs) i(Vb)
.end
