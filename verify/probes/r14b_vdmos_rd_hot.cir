TEXP0 at a clamped junction with explicit RTHJC
* Provenance: original Sansho R14b circuit.
* sweep: texp0 0 1.5 3
.param probe=0
Vd d 0 1
Vg g 0 6
Vj tj 0 60
Vc tc 0 27
M1 d g 0 tj tc pw thermal
.model pw vdmos(vto=1 kp=3 mu=0 rthjc=5 rd=.24 rq=0 vq=1 texp0={probe})
.dc Vd .2 3 .1
.save i(Vd)
.end
